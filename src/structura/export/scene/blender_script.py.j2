"""Structura scene for Blender 4.2+ — run:  blender --python {{ '{' }}this file{{ '}' }}  (or open it in the Text Editor
and press Run). Idempotent: it rebuilds the 'Structura' collection. Geometry is read from '{{ sidecar }}' next
to this script."""

import json
import os

import bpy
import mathutils
import numpy as np

SCENE = json.loads(r'''{{ scene_json }}''')
def _here():
    """The folder of this script, whether run with --python or from Blender's Text Editor."""
    path = globals().get("__file__", "")
    if not os.path.isfile(path):
        text = getattr(getattr(bpy.context, "space_data", None), "text", None)
        path = bpy.path.abspath(text.filepath) if text is not None else path
    return os.path.dirname(os.path.abspath(path))


HERE = _here()
DATA = np.load(os.path.join(HERE, "{{ sidecar }}"))


def remove(col):
    for child in list(col.children):
        remove(child)
    for obj in list(col.objects):
        bpy.data.objects.remove(obj, do_unlink=True)
    bpy.data.collections.remove(col)


def collection():
    old = bpy.data.collections.get("Structura")
    if old is not None:
        remove(old)
    col = bpy.data.collections.new("Structura")
    bpy.context.scene.collection.children.link(col)
    return col


def material(spec, per_instance=False):
    """Principled BSDF whose base colour is the 'Col' attribute (of the instance, for instanced clouds)."""
    mat = bpy.data.materials.new("Structura " + spec["name"] + (" (instances)" if per_instance else ""))
    mat.use_nodes = True
    tree = mat.node_tree
    bsdf = tree.nodes["Principled BSDF"]
    attr = tree.nodes.new("ShaderNodeAttribute")
    attr.attribute_name = "Col"
    attr.attribute_type = "INSTANCER" if per_instance else "GEOMETRY"
    tree.links.new(attr.outputs["Color"], bsdf.inputs["Base Color"])
    tree.links.new(attr.outputs["Alpha"], bsdf.inputs["Alpha"])
    for socket, key in (("Metallic", "metallic"), ("Roughness", "roughness"), ("IOR", "ior"),
                        ("Transmission Weight", "transmission"), ("Coat Weight", "coat"),
                        ("Coat Roughness", "coat_roughness"), ("Anisotropic", "anisotropy")):
        if socket in bsdf.inputs:
            bsdf.inputs[socket].default_value = spec[key]
    if spec["emission"] > 0 and "Emission Strength" in bsdf.inputs:
        tree.links.new(attr.outputs["Color"], bsdf.inputs["Emission Color"])
        bsdf.inputs["Emission Strength"].default_value = spec["emission"]
    return mat


def mesh_object(col, index, spec):
    points, faces, colors = (DATA[f"m{index}_{k}"] for k in ("points", "faces", "colors"))
    mesh = bpy.data.meshes.new(f"Structura_{spec['name']}")
    mesh.vertices.add(len(points))
    mesh.vertices.foreach_set("co", points.ravel())
    mesh.loops.add(faces.size)
    mesh.loops.foreach_set("vertex_index", faces.ravel())
    mesh.polygons.add(len(faces))
    mesh.polygons.foreach_set("loop_start", np.arange(0, faces.size, 3, dtype=np.int32))
    mesh.polygons.foreach_set("loop_total", np.full(len(faces), 3, dtype=np.int32))
    attribute = mesh.color_attributes.new("Col", "FLOAT_COLOR", "POINT")
    attribute.data.foreach_set("color", colors.ravel())
    mesh.update()
    mesh.validate()
    obj = bpy.data.objects.new(mesh.name, mesh)
    obj.data.materials.append(material(spec))
    col.objects.link(obj)


def instancer():
    """The shared Geometry Nodes tree: instance the 'Prototype' object on the points, with the 'rotation'
    (quaternion) and 'scale' point attributes; point attributes such as 'Col' pass on to the instances."""
    group = bpy.data.node_groups.get("Structura Instancer")
    if group is not None:
        return group
    group = bpy.data.node_groups.new("Structura Instancer", "GeometryNodeTree")
    group.interface.new_socket("Geometry", in_out="INPUT", socket_type="NodeSocketGeometry")
    group.interface.new_socket("Prototype", in_out="INPUT", socket_type="NodeSocketObject")
    group.interface.new_socket("Geometry", in_out="OUTPUT", socket_type="NodeSocketGeometry")
    nodes, links = group.nodes, group.links
    source, sink = nodes.new("NodeGroupInput"), nodes.new("NodeGroupOutput")
    info, place = nodes.new("GeometryNodeObjectInfo"), nodes.new("GeometryNodeInstanceOnPoints")
    rotation, scale = nodes.new("GeometryNodeInputNamedAttribute"), nodes.new("GeometryNodeInputNamedAttribute")
    rotation.data_type, scale.data_type = "QUATERNION", "FLOAT_VECTOR"
    rotation.inputs["Name"].default_value, scale.inputs["Name"].default_value = "rotation", "scale"
    links.new(source.outputs["Geometry"], place.inputs["Points"])
    links.new(source.outputs["Prototype"], info.inputs["Object"])
    links.new(info.outputs["Geometry"], place.inputs["Instance"])
    links.new(rotation.outputs["Attribute"], place.inputs["Rotation"])
    links.new(scale.outputs["Attribute"], place.inputs["Scale"])
    links.new(place.outputs["Instances"], sink.inputs["Geometry"])
    return group


def mesh_data(name, points, faces):
    mesh = bpy.data.meshes.new(name)
    mesh.vertices.add(len(points))
    mesh.vertices.foreach_set("co", points.ravel())
    if len(faces):
        mesh.loops.add(faces.size)
        mesh.loops.foreach_set("vertex_index", faces.ravel())
        mesh.polygons.add(len(faces))
        mesh.polygons.foreach_set("loop_start", np.arange(0, faces.size, 3, dtype=np.int32))
        mesh.polygons.foreach_set("loop_total", np.full(len(faces), 3, dtype=np.int32))
    mesh.update()
    mesh.validate()
    return mesh


def instanced_cloud(col, prototypes, cloud):
    key, spec = cloud["key"], SCENE["materials"][cloud["material"]]
    proto = bpy.data.objects.new(f"Prototype {cloud['prototype']} {spec['name']}",
                                 mesh_data(f"Prototype_{key}", DATA[f"{key}_proto_points"],
                                           DATA[f"{key}_proto_faces"]))
    proto.data.materials.append(material(spec, per_instance=True))
    prototypes.objects.link(proto)
    proto.hide_render = True
    proto.hide_set(True)
    points = mesh_data(f"Structura_{key}", DATA[f"{key}_location"], np.zeros((0, 3), np.int32))
    for name, kind, field, values in (("rotation", "QUATERNION", "value", DATA[f"{key}_rotation"]),
                                      ("scale", "FLOAT_VECTOR", "vector", DATA[f"{key}_scale"]),
                                      ("Col", "FLOAT_COLOR", "color", DATA[f"{key}_colors"])):
        points.attributes.new(name, kind, "POINT").data.foreach_set(field, values.ravel())
    obj = bpy.data.objects.new(f"Structura {cloud['prototype']} ({spec['name']})", points)
    modifier = obj.modifiers.new("Structura Instancer", "NODES")
    modifier.node_group = instancer()
    modifier[modifier.node_group.interface.items_tree["Prototype"].identifier] = proto
    col.objects.link(obj)


def camera(col):
    spec = SCENE["camera"]
    data = bpy.data.cameras.new("Structura Camera")
    data.sensor_fit = "VERTICAL"  # Structura's field of view is vertical
    data.sensor_height = spec["sensor_height"]
    data.lens = spec["lens"]
    data.shift_x, data.shift_y = spec["shift"]
    if spec["projection"] == "orthographic":
        data.type = "ORTHO"
        data.ortho_scale = spec["ortho_scale"]
    elif spec["projection"] in ("spherical", "fisheye"):
        data.type = "PANO"
        if hasattr(data, "panorama_type"):  # Blender 4.2+: the panorama settings live on the camera
            data.panorama_type = "EQUIRECTANGULAR" if spec["projection"] == "spherical" else "FISHEYE_EQUIDISTANT"
            data.fisheye_fov = spec["fisheye_fov"]
    dof = spec.get("dof")
    if dof:
        data.dof.use_dof = True
        data.dof.focus_distance = spec["focus"]
        data.dof.aperture_fstop = dof["fstop"]
        data.dof.aperture_blades = dof["blades"] if dof["blades"] >= 3 else 0
        data.dof.aperture_rotation = dof["rotation"]
        data.dof.aperture_ratio = dof["ratio"]
    obj = bpy.data.objects.new("Structura Camera", data)
    obj.location = spec["eye"]
    direction = mathutils.Vector(spec["target"]) - mathutils.Vector(spec["eye"])
    obj.rotation_euler = direction.to_track_quat("-Z", "Y").to_euler()
    col.objects.link(obj)
    bpy.context.scene.camera = obj


def world():
    w = bpy.context.scene.world or bpy.data.worlds.new("World")
    bpy.context.scene.world = w
    w.use_nodes = True
    w.node_tree.nodes["Background"].inputs["Color"].default_value = (*SCENE["background"], 1.0)
    bpy.context.scene.render.engine = "CYCLES"
    bpy.context.scene.cycles.samples = SCENE["samples"]


def prototypes_collection(col):
    """Prototype meshes live in a child collection, hidden: they render only through the instances."""
    protos = bpy.data.collections.new("Structura Prototypes")
    col.children.link(protos)
    return protos


def main():
    col = collection()
    for index, spec in enumerate(SCENE["materials"]):
        if f"m{index}_points" in DATA:
            mesh_object(col, index, spec)
    if SCENE["instanced"]:
        protos = prototypes_collection(col)
        for cloud in SCENE["instanced"]:
            instanced_cloud(col, protos, cloud)
    camera(col)
    world()


main()
