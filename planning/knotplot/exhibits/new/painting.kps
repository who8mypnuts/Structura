Draw=f
if \rr99 < 33 then "frame \ri[0/23];about z \rr360"
if \rr99 < 80 then "torus \rr99 \rr99 \rr99;about z \rr360" else "unknot \ri[3/30] \rr[1/10];about z \rr360"

<randorient.kps

