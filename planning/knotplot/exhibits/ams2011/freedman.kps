reset all

glop back f  % to prevent bad lighting
func 12 <freedman.kps

Draw = f
silent = t
cyl = \rr[.2/.4]
scale=.23
drop all 52 35 -20
hstart = \rr[20/45]
if \rr1 < .96 then "spe back" else "hstart = \rr360"
popview = f
font 4
spe +vwt


ncur = 4
nseg = 14
back = 0


if \rr1 < .3 then "drop ca #ffa500;drop cb #ffa500;drop cc #00f;drop cd #00f"

if \rr1 < .02 then "read psychedelic.kps;cyl=.4"


load Freedman.k



if \rr1 < .5 then "rota z 180"
silent=f

frame comm "read nonp%d.kps"
frame \ri[0/7]

txt centre
txt font 4
txt on
txt c 33 "Complex Unknot"
disp t
nap 2

load FreedmanMovie.k
disp t
Draw=t

nbead mult .3
dstep = 8
ago 102

ncur=3
nseg=12

dstep=2
nbead mult .5
ago 102

dstep=9

nbead mult .5
ago 444

if \rr1 < .021 then <freedman-extra.kps

silent = f
disp t
nap \rr[1/2]





