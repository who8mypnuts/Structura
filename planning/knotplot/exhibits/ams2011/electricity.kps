% variation of graphicsD.kps

% 20 oct 2002

reset all

silent=t
hstar=\rr55
if \rr1 < .4 then "hsta=\rr360"
if \rr12 < 1 then "satu=0"
vcA=1
if \rr3 < 1 then "vcn=\ri[2/7]"

unknot \ri[22/33]

new=f
if \rr15 < 1 then "unknot \ri[8/17] 2"

about z 90

new=t
func 5 torus
func 6 torus
func 7 torus
func 8 torus

func 9 unknot \ri[11/44]

scale=.5
cyl-rad = 1.043649
if \rr3 < 1 then "cyl=\rr[.5/2]"
nsegments = 5
ncurve = \ri[3/6]

value = 0.02
dfunc glowing 22
math k 0 0 .06 s
fixcofm=t

coll a
force 1
go 99999999
%tfunc .1 twfix
tfunc 10 "jit .0001"


silent=f

echo "  "
echo "  "
echo "  "
echo "  "
echo "  "
echo " *** please be patient and watch... "
echo "  "

