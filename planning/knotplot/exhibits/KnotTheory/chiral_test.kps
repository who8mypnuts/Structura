reset all
func 12 <fig8.kps

if stereo then "trz=-45" else ortho

%rotate z -60
%rotate y -45
Draw=f
silent =t
if stereo then scale=6 else scale=1
cyl=.13
ncur = 4
nseg = 15
hstart = \rr360
if \rr1 < .3 then "back=0"
if \rr1 < .6 then "spe back;hstart=\rr[10/50]"

% nap times
par1=.1   % was 1
par2=.1   % was 2
par3=.1   % was 3

load fig8symm.k
load comb fig8symm.k
hincr=0
trans 4 0 0 1 
trx = -2

spe +vwt
font 4
nstring cm -60 "an achiral knot"
disp t
nap \ppar1
nstring cm -85 "is equivalent to its mirror image" 1
disp t
nap \ppar1

nstring cm 165 "these two knots start out looking the same" 2
disp t
nap \ppar1
nstring cm 140 "rotate one by a quarter turn" 3
disp t
#45 about z 2 0;disp t

nstring cm 115 "and they become mirror images" 4
disp t

nap \ppar3
dofx = 0

load 3.1
fitto 1.7
%save dum.k
%load comb dum.k
dupl
hincr=0
refl z 1
string

nstring cm -60 "almost all knots are chiral"
trans 4 0 0 1
disp t 
nap \ppar1
nstring cm -85 "and are not equivalent to their mirror image" 2
disp t 
nap \ppar1

nstring cm -110 "these two versions of the trefoil are mirror images" 3
disp t
nap \ppar1
disp t 
nap \ppar2

nstring cm 165 "these two trefoils are mirror images of each other" 4
disp t
nap \ppar1
nstring cm 140 "rotate one by a half turn" 5
#45 about y 4 0;disp t
nstring cm 115 "and they are still mirror images" 6
disp t
nap \ppar3
silent=f
Draw=t
