; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
AppName=Knot Exhibit (CoLab)
AppVerName=Knot Exhibit (CoLab)
AppPublisher=Hypnagogic
AppPublisherURL=http://www.knotplot.com
AppSupportURL=http://www.knotplot.com
AppUpdatesURL=http://www.knotplot.com
DefaultDirName={pf}\KnotPlot\colabex
DefaultGroupName=KnotPlot
AppCopyright=Copyright © 2003 Robert G. Scharein
WizardImageFile=KnotExhibit.bmp
WizardSmallImageFile=KnotExhibitS.bmp
WindowVisible=yes
OutputDir=C:\rob
OutputBaseFilename=InstallKnotExhibit

; uncomment the following line if you want your installation to run on NT 3.51 too.
; MinVersion=4,3.51


[Files]
Source: "C:\rob\colabex\*.kps"; DestDir: "{app}"; CopyMode: alwaysoverwrite;
Source: "C:\rob\colabex\*.k"; DestDir: "{app}"; CopyMode: alwaysoverwrite;
Source: "C:\rob\colabex\*.txt"; DestDir: "{app}"; CopyMode: alwaysoverwrite;
Source: "C:\rob\colabex\*.cpp"; DestDir: "{app}"; CopyMode: alwaysoverwrite;
Source: "C:\rob\colabex\knotplotrc"; DestDir: "{app}"; CopyMode: alwaysoverwrite;
Source: "C:\rob\colabex\demo.exe"; DestDir: "{app}"; CopyMode: alwaysoverwrite;
Source: "C:\rob\colabex\ms-symm\*"; DestDir: "{app}\ms-symm"; CopyMode: alwaysoverwrite; Flags: recursesubdirs
Source: "C:\rob\colabex\simp\*"; DestDir: "{app}\simp"; CopyMode: alwaysoverwrite; Flags: recursesubdirs
Source: "C:\rob\colabex\demo\*.d*"; DestDir: "{app}\demo"; CopyMode: alwaysoverwrite; Flags: recursesubdirs



