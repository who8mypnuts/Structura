reset all
pop 0
%fullscreen
cursor 1
%aspect=1.3333
persp 60 .2 102.2
clrfun zf

frame comm "read cmode%d"
frame \ri[0/23]

disp t
back=0
back t
sbuff
scale=.75
broff=-.2
ncur=10
nseg=12
cyl=.03
bead=.03
coll a
force 1
draw sbrok
popview=f
mode cbs
func 1 torus \rr99 \rr99 \rr99:about z \rr360
func 2 unknot \ri[3/30] \rr[1/10]:about z \rr360
func 3 untran
func 4 clrfun zf:disp t:clrfun z
func 5 clrfun zf
func 6 clrfun z
func 7 pop 0:fullscreen
func 8 pop 1
func 9 cmode -1
func 10 frame \ri[0/23]
%func 11 ppm dum 2
func 11 <save-cmode.kps
func 12 "reset all;read painting.kps"

go 1000000000
clrfun z

par1 = 325752
