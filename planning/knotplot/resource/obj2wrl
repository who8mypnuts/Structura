#!/bin/csh -f

set file = $1:r".wrl"


cp ~/knotplot/resource/wrl-header $file

echo `date` >> $file

cat ~/knotplot/resource/wrl-data >> $file

grep v $1 | awk '{print $2, $3, $4, ","}' >> $file

echo " 0 0 0] " >> $file

echo "	    } " >> $file
echo "		   IndexedFaceSet {" >> $file
echo "			coordIndex	[" >> $file

 
grep f $1 | awk  '{print $2,  ",", $3,   ",", $4, ",", $5, ", -1," }' >> $file

tail -1 $1 | grep f |  awk  '{print $2,  ",", $3,   ",", $4, ",", $5, ", -1" }' >> $file

echo "]  " >> $file
echo " " >> $file
echo "            } " >> $file
echo "        } " >> $file
echo "    } " >> $file
echo "} " >> $file


echo Data written to file $file
