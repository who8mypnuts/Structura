require accbuff

reset all

silent=t
verbose=f
Draw=f
back=#000
disp t
require accbuff

accbuff decay \rr[.99/.997]
accbuff accum 0.217651
accbuff return 0.225359
background = 0xff000000
accbuff on
accbuff clear

func init
func silent
func 1 <Mandala4b.kps 

line numb 15
line
centre
refl r
cyl=.1
stus=11

func 2 "silent=t;cut \ri[44/108];keep 0;silent=f"
func 4 "silent=t;<weaveA_new.kps"


func exec 4
idle "ago 44;split cyl 0"

scale = 0.622190
cyl-rad = 0.040000



dfunc symm 1 1
func 5 "cmode -1"

vcn=1
vcA=1
vcphi=3.14159

draw spec
tfunc \rr12 "func exec 2" 0 rep 33 108
tfunc \rr12 "func exec 4" 0 rep 9 22
tfunc \rr12 "func exec 5" 0 rep 9 22
tfunc \rr12 "line;cent;refl r" 0 rep 22 77
tfunc \rr[54/108] "read Mandala4b.kps" 0 rep 54 108

func 10 "tfunc .4 {accbuff clear}"
func 9 "full togg;func exec 10"


echo
echo
echo " *** Press F1 to rerun demo with different parameters"
echo "     Press F2 - F6 to change some things, F9 to toggle full screen"
echo "     Press F5 if you don't like the colours, F10 to clear screen"

accbuff
<mandala-common.kps
~title "Mandala 4b"
