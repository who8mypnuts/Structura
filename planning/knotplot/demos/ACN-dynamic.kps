%`-

reset all


par2=3
func init 
func silent
func 1 <ACN-dynamic.kps
silent=t
back=#000

scenery vscale .1
scenery object eobj/wsphere


ortho
mode s
cyl=.1
torus 2 3 \ri[25/40]
fitto 6
refl r
coll a
force 1
velf=t
velmag=.02
mode s
drag=t
cyl=.1
fixcofm=t

glop back t

scenery acn minx 3
scenery acn level 3
scenery acn on
scenery on

txt init
txt font 2
txt left

txt fcolour hsv:102.2/.4/.4 .6
txt fcolour royalblue .5
txt scolour #000
txt sfcolour orange .9
txt lineskip -24

alias ~scenacnminx "scen acn minx $0;echo;echo;echo;echo regions corresponding to $0 crossings or fewer will appear transparent"

txt 20 8 "  "
txt fill on
txt select on
txt group 102

txt 50 a 15 "~scenacnminx 15"
txt 20 a0 14 "~scenacnminx 14"
txt 50 a 13 "~scenacnminx 13"
txt 20 a0 12 "~scenacnminx 12"
txt 50 a 11 "~scenacnminx 11"
txt 20 a0 10 "~scenacnminx 10"
txt 50 a 9 "~scenacnminx 9"
txt 20 a0 8 "~scenacnminx 8"
txt 50 a 7 "~scenacnminx 7"
txt 20 a0 6 "~scenacnminx 6"
txt 50 a 5 "~scenacnminx 5"
txt 20 a0 4 "~scenacnminx 4"
txt 50 a 3 "~scenacnminx 3"
txt set selected
txt 20 a0 2 "~scenacnminx 2"
txt 50 a 1 "~scenacnminx 1"
txt 20 a0 0 "~scenacnminx 0"

txt fill off
txt 10 a "transparent:"
txt lineskip -15
txt 10 a "to show as"
txt 10 a "crossing number"



txt lineskip -24
txt right
txt -15 50 " "
txt fill on
%txt -15 a 8 "scen acn level 8"
txt group 108
txt -15 a 5 "par2=5;scen acn level \ppar2"
txt -15 a 4 "par2=4;scen acn level \ppar2"
txt -15 a 3 "par2=3;scen acn level \ppar2"
txt set selected
txt -15 a 2 "par2=2;scen acn level \ppar2"
txt fill off
txt select off
txt group 0
txt -10 a "refinement level:"

txt right
txt fill on

txt -15 a1.3 "new knot" <ACN_new_knot.kps
txt -15 a "jitter knot" "jitter \rr[1/3];echo;echo;echo *** knot type allowed to change if lots of jittering;echo"

txt centre
txt c 15 "run other ACN demo" <ACN-static.kps
txt c a "rerun this demo" <ACN-dynamic.kps

txt fill off
txt font 4
txt c -20 "Average Crossing Number Map"


txt font 4
txt fill on
txt right
txt -14 14 ? "help popup ACN-dynamic.kps handoff"

txt on

verbose = f

idle "ago 1;scen acn level \ppar2"
spec +swri

silent=f
echo
echo
echo " *** Rotate the scene with the mouse, or "
echo "     drag the knot itself (click down on knot and drag mouse)"

exit
%`+
Average Crossing Number Map

This demo attempts to illustrate how the average crossing number (ACN)
is computed.  In the window, you should see a sphere enclosing a knot. The
sphere has a number of different coloured regions, possibly transparent.  
The colour indicates the number of crossings seen from a great distance
in the direction of that region.

There is also a small white dot at the centre of the window.  If this white
dot is showing through one of the regions, then the knot will appear to 
have a crossing number corresponding to that region. 

What the buttons are for:

   --- the `crossing number to show transparent' buttons allow you to change 
       how many crossings correspond to the transparent region. any regions
       with a crossing number less than or equal to the number selected will
       be transparent.

   --- the `refinement level' controls how fine the detail is in the map.
       larger numbers make for a nicer looking map, but make it slower to draw.

Things to try:

   --- direct manipulation of the knot is enabled for this demo.  hover your
       mouse over part of the knot until a small white icosahedron appears. 
       then click down (left mouse) and drag.  


For more information on how to read the map, click on the `explanation' button
on the other ACN demo.

