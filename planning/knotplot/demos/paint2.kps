% Painting

% Rob Scharein --- 8 April 2002
% based on 7oct94c

reset all
func init
func silent
func 1 <paint2.kps
silent = t
back = 0
blend one one
mathsv k 0 0 0 s
mathsv k 0 0 0 d
mathsv k 0 0 0 a

mathsv b 0 0 0 s
mathsv b 22 .9 .5 d
mathsv b 0 0 0 e

bead-rad = .05 

mode b
sbuff
clrfun zf
disp
disp
backf t

clrfun 1
value=.02

knot num \ri[2/15]

silent = f
echo " "
echo " "
echo  "  *** Paint with mouse in main window"  
echo " "

