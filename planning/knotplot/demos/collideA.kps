require KPbuild 4359

reset all

verbose=f
silent=t
func init
func silent
func 1 <collideA.kps
func 2 velocity rad \rr[-.1/-1]
func 3 "dupl;trans 6 0 0 last"

unknot \ri[6/18] 4

persp 60 .2 120
refl r

Draw=f
ago 22
Draw=t

vscale=.21

trans 30 0 0 
#3 dup;about z 90 0;about z -90

ago 1

force 1
velmag=.001
velf=t

func exec 2
go

tfunc 3 "func exec 2" 0 rep 1 3

mathsv b 0 0 1 d
bead=1

if \rr22 < 1 then "mode B;texture env lupin;texture on"

surf radf arc vcn mul vcphi add csquare vcA mul 1 add cyl mul
vcn=\ri6
vcphi = \rr6.28
vcA = \rr[.4/.9]

silent=f

echo
echo
echo
echo
