txt 15 a 10.82 "read min-step.kps 10.82 7 mscl/167.b 2"  % 420 beads

txt fill off
txt 10 a "knot type:"
txt pop
txt group 2 off


txt group GROUP on

txt group 102
alias ~group "txt group 0 off;txt group 1 off;txt group 2 off;txt group $0 on"

txt sfcolour orange .9


txt fill on
txt select on
txt 15 a1.5  "1" "~group 0"
if GROUP == 0 then "txt set selected"
txt 38 a0 "2" "~group 1"
if GROUP == 1 then "txt set selected"
txt 61 a0 "3" "~group 2"
if GROUP == 2 then "txt set selected"
txt select off
txt fill off
txt 10 a "show group:"

txt fill on
txt right
txt font 4
txt -15 15 ? "help popup min-step.kps handoff"

txt font 3
txt fill off
txt -15 a2 " "
txt fill on
txt -15   a "pick one" "go 0;~choose \ri[1/NUMBER] NUMBER" 

txt fill off 
txt -10 a "action:"

txt -15 a2 " "
txt fill on
txt -15 a "data"   "www knotplot.com/data/min-step"
txt -15 a "paper"  "www iopscience.iop.org/article/10.1088/1751-8113/42/47/475006"
txt fill off
txt -10 a "web:"

alias ~choose "echo knot $0 of $1;load |$0;txt delete GO;txt delete join;~label $0 $1"
alias ~label  "txt centre;txt fill off;txt font 4;txt c 20 {knot $0 of $1}"

exit

%`+

This demo shows a portion of the minimal step embeddings on the simple cubic lattice
for proper knots to 10 crossings. These were reported in the paper
Bounds for the minimum step number of knots in the simple cubic lattice
R Scharein, K Ishihara, J Arsuaga, Y Diao, K Shimokawa and M Vazquez
Published 9 November 2009, IOP Publishing Ltd
Journal of Physics A: Mathematical and Theoretical, Volume 42, Number 47
(click `min step paper' button in the KnotPlot Arena to access the paper)

The available sequences are knot up to nine crossings that have at least two
representatives. Also the number of vertices is limited to 3000. To access all
the sequences, click the `min step data' button in the KnotPlot Arena. 

The data was obtained by Rob Scharein in 2008 whilst working for San Francisco
State University under the supervision of Mariel Vazquez and Javier Arsuaga.

Support for this work came from NIH grants 2S06GM052588 and NSF DMS-0920887.


