%`-


% created Sunday, 19-Sep-21 13:37:06 PDT by running min-step.php in /Users/rob/projects/knots/newdemos

require KPbuild 4996   % for save |c when there are no beads
                       % also for KnotPlot scripts with parameters

% NOTE: this script is meant to be called with arguments, for example
% read min-step.kps 10.157 2 mscl/242.b 2
% which will set
% KNOTNAME to 10.157
% NUMBER to 2
% SEQFILE to mscl/242.b
% GROUP to 2

% PARAM KNOTNAME NUMBER SEQFILE GROUP

% RGS 14 August 2021
% show all NUMBER minimal step KNOTNAMEs in random positions

reset all
silent = t

mode cb
cyl-rad = 0.12
bead-radius = 0.18
ccmode = 2
scale = 0.23
force 1
coll a
velf = t

% load all the knots in the sequence into internal knots
sequence open SEQFILE
frame comm "project random;shift random;centre mass;save |%d;sequ +"
frame 1 to NUMBER
sequence close

frame command "load |%d;translate \rr[11/44] 0 0 ;project random;load combine |c;save |c"

% save |c when there are no beads delete |c if it exists
alias ~combine "echo -n .;echo -f;delete all;save |c;frame 1 to NUMBER"

frame verbose off
until once yes
verbose = 0    % to keep project quiet

silent = f

#5 echo 
echo -n "finding a safe embedding, please wait "
timer start
until safe ~combine
echo -n " "
timer check


revbeads random

% end of interesting code
% everything below here is just for the demo

txt group 102

echo
if NUMBER == 1 then "echo NUMBER minimal step KNOTNAME knot" else "echo NUMBER minimal step KNOTNAME knots"
if NUMBER == 1 then "echo rotate/scale the view to see it if it's not showing" else "echo rotate or scale the view to see them all"


txt font 4
txt centre
alias ~one "txt c -20 {NUMBER minimal step KNOTNAME knot}"
alias ~many "txt c -20 {NUMBER minimal step KNOTNAME knots}"
if NUMBER == 1 then ~one else ~many

txt font 3
txt lineskip 17
alias ~rotMany "txt c a {rotate/scale the view to see them all}"
alias ~rotOne "txt c a {rotate/scale the view to see it if it's not showing}"
if NUMBER == 1 then ~rotOne else ~rotMany
txt c a "click on the KNOTNAME button on the left to create another arrangement"
txt c a "or try another knot type (they are in 3 groups)"

txt fcolour royalblue .6
txt fill on
txt font 4
txt c 20 GO ~go
txt on
txt clobber on

alias ~openall "open all;tanf = on;txt font 3;txt fill on;txt c 20 {join all} {join all;txt delete join}"

alias ~go "go;txt delete GO;tfunc \rr[2/6] ~openall"


txt lineskip -25
%txt -15 a2  "toggle fullscreen" "fullscreen toggle"


txt left
txt font 3
txt push
txt group 0
txt fill off

txt 15 0 " "
txt fill on
txt 15 a 9.31 "read min-step.kps 9.31 1 mscl/67.b 0"  % 54 beads
txt 15 a 9.29 "read min-step.kps 9.29 8 mscl/65.b 0"  % 448 beads
txt 15 a 9.19 "read min-step.kps 9.19 20 mscl/55.b 0"  % 1080 beads
txt 15 a 9.5 "read min-step.kps 9.5 35 mscl/41.b 0"  % 1890 beads
txt 15 a 9.4 "read min-step.kps 9.4 26 mscl/40.b 0"  % 1404 beads
txt 15 a 8.20 "read min-step.kps 8.20 5 mscl/35.b 0"  % 220 beads
