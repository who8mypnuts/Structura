txt fill off
txt 10 a "knot type:"
txt pop
txt group 0 off

txt push
txt group 1
txt fill off

txt 15 0 " "
txt fill on
txt 15 a 10.73 "read min-step.kps 10.73 30 mscl/158.b 1"  % 1800 beads
