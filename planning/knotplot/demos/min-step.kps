txt fill off
txt 10 a "knot type:"
txt pop
txt group 1 off

txt push
txt group 2
txt fill off

txt 15 0 " "
txt fill on
txt 15 a 10.165 "read min-step.kps 10.165 44 mscl/250.b 2"  % 2464 beads
txt 15 a 10.162 "read min-step.kps 10.162 32 mscl/247.b 2"  % 1792 beads
