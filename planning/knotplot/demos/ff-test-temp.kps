require KPbuild 4556

reset all

silent=t
func silent
func 1 <fireflies.kps

anchor = true
ancauto = false

% why does draw flat and draw hflat turn off anchor lines?

alias ~ah "txt hide \rr[5/6]"



N-torus=\rr[900/1600]
rand eunif -25 25 -25 25 -25 25
anchor
rand unif -35 35 -25 25 -15 -14

% interesting when sound on:
alias ~x "unknot;anchor;jitter 99999;fitto 10"
alias ~y "torus;anchor;jitter 99999;fitto 10"

alias ~inv "test paradj 0 -1 0;test paradj 1 -1 0;test paradj 2 -1 0"
alias ~adj "test paradj 0 1 \rr+-0.001;test paradj 1 1 \rr+-0.001;test paradj 2 1 \rr+-0.001
alias ~yyy nop
alias ~ago "ago 1"

alias ~rot "rotate x \ppar0;rotate y \ppar1;rotate z \ppar2;~inv;about x \ppar0;about y \ppar1;about z \ppar2;~inv"


par0 = \rr+-55
par1 = \rr+-55
par2 = \rr+-55

~rot

par0 = \rr+-.2
par1 = \rr+-.2
par2 = \rr+-.2

coll a 
force 1


back=black

mode b
mathsv b 1 0 1 d
mathsv b 1 0 1 e
mathsv b 0 0 0 s


bead=.05

nsegments = 4
ncurve = 15
cyl-rad = 0.100000


silent=f

cursor 0
go

