%reset all
if par9 != 8263493 then "reset all;back=#000" else <wave-init.kps

silent=t
scale=\rr[.33/.65]

%mode wbc
%mode cb
cyl=.06
line dir 1 0 0
line numb 13
line
cent
coll a
force 1
mass open
jit .1
if \rr2 < 1 then "about z 90"
if \rr2 < 1 then "about y 90"
<randorient.kps
wavefront skip 13
wavefront start 6
wavefront nwaves 222
wavefront c \rr[2/7]
wavefront nseg \ri[3/10] \rr360
wavefront init



%go 999999999 limit 30
%silent=f
%exit


verbose = f

%tfunc 2 "coll a;force 1"
coll a
force 1

go inf limit 30

func init
func silent


alias ~sel5 "txt set selected"
<wave_demo_aux.kps
alias ~sel5 nop
txt exec wbc 109
silent=f
