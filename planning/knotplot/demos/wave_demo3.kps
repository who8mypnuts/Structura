%reset all 
if par9 != 8263493 then "reset all;back=#000" else <wave-init.kps

silent=t
%mode bw

wavefront start 0
if \rr2 < 1 then "wavefront skip 8" else "wavefront skip 1"

wavefront c \rr[2/5]
wavefront nwaves 240
force 1
coll a
unknot 80
about z 90
if \rr2 < 1 then revb
<randorient.kps


go inf limit 30

func init
func silent

alias ~sel3 "txt set selected"
<wave_demo_aux.kps
alias ~sel3 nop
txt exec wb 109

silent=f
