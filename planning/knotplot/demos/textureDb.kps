reset all
back=0
disp t
texture reset
texture appmode replace
texture environment SphereMap
charge = 0.130000
spring-length = 1.200000
rot x \rr[-70/110]
elecforce = on
mechforce = off
amechforce = on
bead-radius = 0.600000
velforce = on
velmag = 0.037280
mode B
tanf=f
scale = \rr[.8/1.3]
knot
mathsv b \rr360 \rr1 1 d
glop backface t
back=0
texture on

if \rr10 < 1 then "tex lupin"

<randorient.kps
if \rr10 < 3 then "texture appmode modu" else "texture appmode repla"
<demo-relaxA.kps
