<graphicsE.kps

%func 2 "knot 1;scale \rr[1/2];texture rep -1 -1"
func 2 "knot 1;texture rep -1 -1"
func 11 full tog
func 10 "brof=\rr+-4"
func 9 "twfix \rr+-222"
func 12 <aum-fly.kps
mech = t
elec = t
velf=t
force 1
coll a

%fly \rr[102.2/222]
fly \rr[222/666]

if \rr2 < 1 then "brof=\rr[-4/-2]" else "brof=\rr[1/3]"

sradius = 0.680000

texture norm aum
draw tbro
texture on
texture rep -1 -1
blend one one
zbuff f
go

