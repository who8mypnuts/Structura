% button LABEL ACTION XPOS YPOS WIDTH HEIGHT
% if XPOS == -2 then XPOS = hspace
% if XPOS < 0.0 then XPOS += (hspace + prev_button_width)
% if WIDTH <= 0.0 then WIDTH = 

