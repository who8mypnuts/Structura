echo 
echo 
echo "  *** Trying to make into three components by changing breakline pattern."
echo "      (will abort after 20 seconds if unsuccessful)"
echo -f

silent=t
tfunc reset
until timelimit 20
delete all
until Ncomp 3 "func exec 5;func exec 9;disp t"
silent=f

if \pncomps == 3 then "echo Success!  Number of components is three!" else "echo Procedure failed!!  :-("
if \pncomps != 3 then "echo Try pressing SHIFT-F9 and then SHIFT-F12 again."
if \pncomps == 3 then "echo Try also SHIFT-F10 or SHIFT-F11."
