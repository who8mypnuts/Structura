reset all
silent=t
background = black
disp t
ortho

coll allow  % in case people wonder why there are self-intersections

dstep = \ri[1/3]  
hstart=\rr360

if \rr2 < 1 then "auto-colour=off"

hincr=\rr[20/180]
satu=\rr[.7/1.0]
ncur=\ri[3/4]
nseg=10
sradius=\rr[.3/.5]
cradius=\rr[.3/.5]

force 1
velfo=t
vcA=\rr[.2/.9]

if \rr9 < 1 then "mathsv k \rr55 1 \rr.4 e"

if \rr1 < .05 then "vcn=\ri[1/5]"
velmag=\rr[.05/.1]
back=0
glop backface f

cradius = 1.043649
sradius = 1.043649
nsegments = 3
ncurve = 1
value = 0.030000
dfunc glowing
if \rr2 < 1 then "mathsv k 0 0 .2 s" else "mathsv k 0 0 \rr.2 s"
vscale=.23
cradius=.4
sradius=.4


if \rr2 < 1 then "knot cd \ri[3/8] d" else "knot cd \ri[3/7] c"
<randorient.kps
if \rr2 < 1 then revb
if \rr2 < 1 then "hincr=0"

fitto 16
centre mass


if \rr4 < 1 then "tanf=on"
tanmag = \rr[.005/.1]

if \rr66 < 1 then "<delay-power.kps"

go 
silent=f

