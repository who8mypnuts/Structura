require KPbuild 4965

reset all

silent=t
func init
func silent
func 1 <10dec05a.kps
func 2 "echo;echo Randomizing bead locations;jitter 99999;fitto 10"
func 3 "echo;glue init;frame 0 num \ri[1/4]"
func 4 "func exec 3;func exec 2"

verbose=f
back=0
sat = \rr1
cyl=.2
cluster=.6
mode sC
scale=.25
knot 
refine nbead mult .7
refl r
save |tmp
hstart=\rr360
fixcofm=t

%frame comm "knot 1;nbead mult .7;refl r;load comb |tmp;save |tmp"
frame comm "knot;refine nbead mult .7;refl r;load comb |tmp;save |tmp"  % require KPbuild 4965
frame 0 num \ri[1/5]

hincr = 0
mathsv C \phsta \psatu 1 d

%#12 glue -1 -1
%tfunc 1 "glue -1 -1" 0 rep 10 20
tfunc 1 "glue -1 -1" 0 rep 1 \rr[1/10]

frame comm "glue -1 -1"
coll a
force 1
velf=t
dstep=\ri[1/3]
go 


silent=f


echo
echo
