if stereo then nop else <anaglyphButtons.kps

%button DemoB "Never Ending Exhibitions" nop -2 -1 102 10 4 0
%button DemoB "View List" "panel set DemoB 1" -2 -1 0 0

%button pos 2
%button A <anaglyphrcA.kps 
%button B <anaglyphrcB.kps 
%button C <anaglyphrcC.kps 
%button D <anaglyphrcD.kps 
%button E <anaglyphrcE.kps 
