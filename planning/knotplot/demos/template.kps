reset all

silent=t
verbose=f

alias ~ah "txt hide \rr[5/7]"
func 1 <template.kps

timer start
txt fcolour royalblue .6
txt sfcolour #fb0 .8
txt scolour #000

~ah
txt fill on
txt font 3
txt cent
txt c 20 "reload demo" <template.kps

txt right
txt lineskip -25

~ah
txt font 4
txt fill on
txt -15 15 ? "help popup template.kps handoff"
txt font 3

~ah
txt -15 a1.5 fullscreen "full toggle"
txt fill off
txt -10 a toggle:
txt fill on

txt on

~ah
txt autohide on   % should be the last txt command

silent=f
