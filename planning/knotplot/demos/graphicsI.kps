<StElmo_aux.kps
if \rr2 < 1 then "persp \rr[55/77]"
silent=t
scale=\rr[.2/.5]

if \rr11 < 1 then "persp 150;scale=1.3"

knot spe
<randorient.kps
if \rr9 < 1 then "about z 90"
if \rr9 < 1 then "about x 90"
if \rr9 < 1 then "about y 90"
if \rr14 < 1 then "refl r"

silent=f


echo " "
echo " "
echo " *** Random parameters, try again... "
echo "     Variation on `St. Elmo'."
echo " "

