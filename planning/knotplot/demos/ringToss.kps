require KPbuild 4965

reset all

func init 
func silent
func 1 <ringToss.kps

silent=t
back=0
disp t
tfunc allowreset
%fredisp=t
%Debug=t
Draw=f
%conway 10*
delete all

Draw=t
coll allow  % in case people wonder why there are self-intersections

tg1off = \rr[2/6]

dstep = \ri[1/3]  
hstar=\rr360
auto-colour=off
hincr=\rr[20/180]
satu=\rr[.7/1.0]
ncur=\ri[3/4]
nseg=10
cyl=\rr[.3/.5]
force 1
velfo=t
vcA=\rr[.2/.9]
if \rr1 < .2 then "mathsv k \rr55 1 .5 e"
if \rr1 < .05 then "vcn=\ri[1/5]"
velmag=\rr[.05/.1]
back=0
glop backface f

if \rr1 < .15 then "tangle 2@!z#" else "tangle 111Z1Z11c"
refl r
swap randomize
save |tmp

if \rr1 < .15 then "tangle 2@!z#" else "tangle 111Z1Z11c"
refl r
swap randomize

if \rr6 < 1 then "open 0"
if \rr6 < 1 then "open 1"
if \rr12 < 1 then "open 2"

if \rr1 < .9 then "refl r;trans \rr[3/10];load comb |tmp;cent"
%if \rr1 < .7 then "refl r;trans 3;load comb |tmp;cent"

<randorient.kps
if \rr1 < .5 then "refl rr" else "refl r"
if \rr1 < .01 then "draw spec"
if \rr1 < .4 then "scale \rr[.5/2] \rr[.5/2] \rr[.5/2]"

if \rr11 < 3 then "mode q"
if \rr11 < 1 then "mode cbf;a-scale=.01;cyl=0.18;bead=0.3"

if \rr102 < 1 then "sbuff;clrf n"
if \rr1 < .01 then "spec;texture SphereMap;texture mode modu;sat=\rr.5;cyl=1"
%if \rr1 < .01 then "spec;texture SphereMap;texture mode replace;sat=\rr.5;cyl=1"
if \rr16 < 1 then "read electric.kps;ncur=4;spec"

%cyl=2
%texture varo
%texture mode modu

if \rr17 < 1 then "open all;glop backface f"

go
if \rr3 < 1 then "tfunc \rr[2/6] split"
%ago 222
silent=f

echo " "
echo " "
echo " *** Allowing crossing changes."
echo " "

