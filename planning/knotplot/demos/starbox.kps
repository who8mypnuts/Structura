reset all

% demo of Celtic stars and boxes

func init
func silent
func 1 <starbox.kps
func 5 "go 0;load |.before"

cyl=\rr[.2/.6]
scale = 0.237
hstar=\rr360
sat=\rr[.7/1]
silent=t

if \rr4 < 3 then "rot x \rr[-44/-75];rot z \rr360"

if \rr11 < 10 then "draw norm" else "draw spec"

% 1 Right  2 Left  4 Top  8 Bottom  16 Front  32 Back


par0 = \ri[4/6]
if \rr2 < 1 then "par1=63" else "par1=47"

% multiif < starbox.txt 
par2 = \rr28
if par2 < 10 then "celtic box \ri[1/6] \ri[1/6] \ri[1/6] \ppar1;celtic scale 2;par2=30"
if par2 < 20 then "celtic box \ppar0 \ppar0 \ri[1/4] \ppar1;celtic scale 2;par2=30"
if par2 < 29 then "celtic star \ri[3/7] \ri[1/5];par2=30"

celtic auto f
celtic random active \rr[.6/1.3]

tfunc allowreset
tfunc \rr[.2/4] "if \rr3 < 1 then <plaits_aux1.kps"
tfunc \rr[.2/4] "if \rr3 < 1 then <plaits_aux2.kps"
tfunc \rr[3/8]  "if \rr3 < 2 then <plaits_aux3.kps"
tfunc \rr[4/10] <demo-relaxB.kps

celtic show 43

<plaits_aux4.kps


stus=8
silent=f

echo 
echo
echo Unfinished demo
echo


