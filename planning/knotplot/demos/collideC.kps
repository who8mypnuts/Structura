reset all

verbose=f
silent=t
func init
func silent
func 1 <collideC.kps
func 2 velocity rad \rr[-.1/-1]
func 3 "dupl;trans 6 0 0 last"



persp 60 .2 120

Draw=f
conway 2
refl r
ago 333
Draw=t

scale=.21

trans 40 0 0 
save |.tmp
#3 about z 90;load comb |.tmp

about z 45

ago 1

force 1
velmag=.001
velf=t

func exec 2
go

tfunc 3 "func exec 2" 0 rep 1 3

mathsv b 0 0 1 d
bead=1

if \rr22 < 1 then "mode B;texture env lupin;texture on"


silent=f

echo
echo
echo
echo
