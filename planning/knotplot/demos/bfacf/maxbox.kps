if \ppar0 != 9152998 then <bfacf/slab-init.kps

#4 echo
txt init
txt centre
txt font 4
txt c -20 "Maximal stick in a box"
txt on

txt clobber on

alloc 27000

func 1 <bfacf/slab-config1.kps
func 2 <bfacf/slab-config2.kps
func 3 <bfacf/slab-config3.kps
func 4 <bfacf/slab-config4.kps
func 5 <bfacf/slab-config5.kps
func 6 <bfacf/slab-config6.kps

par2=1
func c 1 "bfacf latshow 15;bfacf box 15"
func c 2 "bfacf latshow 10;bfacf box 10"

func exec \ri[1/6]
func exec c 1

txt fcolour hsv:108/1/1 .6
txt fcolour hsv:108/.6/.6 .6
txt font 3

txt group 33
txt lineskip -25
txt 15 0 " "
txt fill on
txt 30  a "8 xing" "func exec 6;func exec c \ppar2"
txt 30  a "7 xing" "func exec 5;func exec c \ppar2"
txt 30  a "6 xing" "func exec 4;func exec c \ppar2"
txt 30  a "5 xing" "func exec 3;func exec c \ppar2"
txt 30  a "4 xing" "func exec 2;func exec c \ppar2"
txt 30  a "3 xing" "func exec 1;func exec c \ppar2"

txt fill off
txt left
txt 5 a "Configurations:"


txt fill on
txt 20 a1.5 "big box" "par2=1;func exec c \ppar2"
txt 20 a    "small box" "par2=2;func exec c \ppar2"

txt centre
txt fill on
txt c 20 "search for max" <bfacf/slab-maxstick.kps

txt group 0
