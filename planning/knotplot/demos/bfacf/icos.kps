delete all

new=true

frame comm "unknot 3 1.5;about z 30;trform icos %d;save \icos%d"
frame 0 numb 20



bfacf init
%load mscl/3.1
%trans 28 0 0
%bfacf load

bfacf load x

load \icos0
frame comm "load comb \icos%d"
frame 1 to 19

scale 7


info
cyl=2

bfacf clear 35

bfacf fill tube
bfacf dilate
bfacf clear tube

spec bfacf
keep 0
save \0
delete all
bfacf latshow 45

bfacf fill

bfacf copy
cyl=.1

