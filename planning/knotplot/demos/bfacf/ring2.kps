if \ppar0 != 4983689 then <bfacf/ring2-init.kps

#4 echo
txt init
txt centre
txt font 4
txt c -20 "Rectangular ring cavity with crosspipe"
txt on

alloc 5555

func 1 <bfacf/ring2-config1.kps
func 2 <bfacf/ring2-config2.kps
func 3 <bfacf/ring2-config3.kps
func 4 <bfacf/ring2-config4.kps
func 5 <bfacf/ring2-config5.kps
func 6 <bfacf/ring2-config6.kps

func exec \ri[1/5]

txt fcolour hsv:108/1/1 .6
txt fcolour hsv:108/.6/.6 .6
txt font 3

txt lineskip -25
txt 15 0 " "

txt left
txt fill on
txt 25 a "ring 1" "read bfacf/boxinit.kps;read bfacf/ring.kps;read bfacf/buttons.kps"
txt fill off
txt 15 a "Other rings:"

txt fill on
txt 25  a2 6 "func exec 6"
txt 25  a 5 "func exec 5"
txt 25  a 4 "func exec 4"
txt 25  a 3 "func exec 3"
txt 25  a 2 "func exec 2"
txt 25  a 1 "func exec 1"
txt fill off
txt left
txt 15 a "Configurations:"


