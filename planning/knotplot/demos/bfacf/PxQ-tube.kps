require KPbuild 4990   % for notify, screen

require KPbuild 4790
reset all

alias 2x2 "alias PxQ-title {~title $0 2x2};alias PxQ-load {load mscl/$0};alias PxQ-save {save -a 2x2-$0-!.news news};read bfacf/2x2-tube.kps"

alias 2x2r  "2x2 $0_$1"
alias 2x2r8  "2x2r 8 \ri[1/21]"
alias 2x2r7  "2x2r 7 \ri[1/7]"


alias 1x3 "alias PxQ-title {~title $0 1x3};alias PxQ-load {load mscl/$0};alias PxQ-save {save -a 1x3-$0-!.news news};read bfacf/1x3-tube.kps"
