require KPbuild 4691
require KPbuild 4382

reset all

%bfacf nap .1
bfacf init

scenery object recombo resident
bfacf init knotmode
ccmode=2

txt clobber on
txt font 4
txt centre
txt c -20 "recombination test"
play init

alias ~tlink "torus 2 $0;test clkembed"

alias ~sinit "scenery init;scenery object recombo resident;scenery dscale .4;scenery on"
alias ~bload "bfacf load;bfacf box 11"

bfacf centre off

txt fill on
txt fcolour "royal blue" .7
txt font 3

alias ~but "txt push;txt cent;txt fill on;txt group 108;txt c 20 {search for sites} <bfacf/recombo-search.kps;txt pop"

~but
alias ~yikes "test yikes"
txt push
txt fill on
txt group 108
txt c 50 "recombo once" "save |x;bfacf recomb;bfacf recomb showsites"
txt pop
txt group 108 off

alias ~kload "verb=t;echo;echo;knot numb $0 mscl;verb=f;silen=t;~sinit;~bload;bfacf recomb showsites;txt group 327645 on;txt group 108 on;txt delete group 102;~rbfs;silent=f"
alias ~kloadT "verb=t;echo;echo;~tlink $0;verb=f;silen=t;~sinit;~bload;bfacf recomb showsites;txt group 327645 on;txt group 108 on;txt delete group 102;~rbfs;silent=f"

%  mscl;~sinit;~bload;bfacf recomb showsites;txt group 108 on;txt delete group 102"

txt left
txt lineskip -25
txt 15 15 "T(2,8)" "~kloadT 8"
txt 15 a "T(2,6)" "~kloadT 6"
txt 15 a "4-comp" "~kload \ri[379/383]"
txt 15 a "3-comp"  "~kload \ri[343/378]"
txt 15 a "2-comp"  "~kload \ri[251/342]"
txt 15 a  "1-comp" "~kload \ri[1/250]"
txt fill off
txt 10 a "load:"
txt right 
txt fill on
txt -15 15 "fullscreen" "full togg;~rbfs"
txt -15 a arrows "show ~orient"
txt -15 a scenery "scenery toggle"
txt -15 a music "play toggle"
txt fill off
txt -10 a "toggle:"
txt push
txt fill on 
txt sfcolour orange .9
alias ~doit nop
alias ~recomb "bfacf recomb"
%alias ~recomb "bfacf recomb;cons IDclk.php"
txt group 9876
txt select on
txt -15 a2 "search and recomb" "alias ~doit ~recomb"
txt -15 a  "only search"  "alias ~doit nop"
txt set selected
txt fill off
txt -10 a "while searching:"
txt fill on
txt group 765765
txt -15 a2 "on " "bfacf recomb limit on"
txt -15 a "off" "bfacf recomb limit off"
bfacf recomb limit off
txt set selected
txt fill off
txt -10 a limit:
txt fill on
txt group 857265
txt -15 a2 "on " "bfacf recomb direct on"
txt set selected
bfacf recomb direct on
txt -15 a "off" "bfacf recomb direct off"
txt fill off
txt -10 a direct:

txt group 23547
txt fill on
txt -15 a2 80 "bfacf nedg 80 1000"
txt -15 a 40 "bfacf nedg 40 1000"
txt -15 a 0 "bfacf nedg 0 1000"
txt set selected
bfacf nedg 0 1000
txt fill off
txt -10 a nedges:

txt group 23548
txt fill on
txt -15 a2 30 "bfacf recomb dist 30"
txt -15 a 20 "bfacf recomb dist 20"
txt -15 a 10 "bfacf recomb dist 10"
txt -15 a 0 "bfacf recomb dist 0"
txt set selected
bfacf recomb dist 0
txt fill off
txt -10 a distance:

txt select off 
txt pop

txt push
txt lineskip 20
txt left
txt fill on
txt group 327645
txt font 2
txt fcolour skyblue .3
txt 15 -25 "fun 1" <bfacf/recombo-fun1.kps
txt 15 a   "fun 2" <bfacf/recombo-fun2.kps
%txt 15 a   "fun 3" <bfacf/recombo-fun3.kps
txt group 327645 off
txt pop

txt push
txt group 102
txt fill off
txt cent
txt font 4
txt lineskip 44
txt c -108 "This demo uses sound, make sure your volume is not too high"
txt c a "the pitch of the note indicates the number of sites found"
txt c a2 "click on one of the blue buttons in this window to load something"
txt c a "and then click on the `search for sites' button that will appear"
txt c a2 "you can rotate and scale the scene during the search process,"
txt c a "as well as load a new knot using one of the blue buttons"
txt c a2 "NOTE: do not use the `step' or `run' buttons on the Control Panel"
txt c a   "as this will mess things up, however, using the sliders is fine"
txt pop

txt on

scale=.8
viewmatrix 0.777146 0.629320 0.000000 -0.230647 0.284825 0.930418


show orient
3dop ostep 1
3dop oscale .25

alias ~rbfs "bindkey { } {txt toggle}"

