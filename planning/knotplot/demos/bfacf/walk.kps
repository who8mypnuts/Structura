
alloc 20000


if \ppar0 != 1284174 then <bfacf/walk-init.kps


% get a knot to walk along a labyrinth


#4 echo
silent=t

txt init
txt centre
txt font 4
txt c -20 "Knot walks a labyrinth"
txt on
txt fcolour hsv:108/.6/.6 .6

txt fill on
txt font 3

txt clobber on

txt c -50 "walk now" <bfacf/walk-start.kps


load mscl/3.1
trans 4 -65 0
bfacf load
spec bfacf
mode 0

bfacf clear 30
cyl-rad=1

delete all
new=f
frame comm "unknot 10 %d"
frame 1 to 20
scale .4
save |tmp
trans 0 1 0

load ravenna.k

txt fill off
txt c 10 "Labyrinth in San Vitale, Ravenna, Italy"


fitto 65
mode s
load comb |tmp
bfacf fill tube
bfacf dilate
bfacf clear tube


bfacf latshow 67 67 7


bfacf fill

cyl-rad=.1
mode cB
bfacf step 1


silent=f
echo
echo
echo "Labyrinth in San Vitale, Ravenna, Italy"
echo


