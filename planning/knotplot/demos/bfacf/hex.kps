if \ppar0 != 3196064 then <bfacf/hex-init.kps

#4 echo
txt init
txt centre
txt font 4
txt c -20 "Hexagonal slab"
txt on


alloc 5555

func 1 <bfacf/hex-config1.kps
func 2 <bfacf/hex-config2.kps
func 3 <bfacf/hex-config3.kps
func 4 <bfacf/hex-config4.kps
func 5 <bfacf/hex-config5.kps
func 6 <bfacf/hex-config6.kps

func exec \ri[1/3]

txt fcolour hsv:108/1/1 .6
txt fcolour hsv:108/.6/.6 .6
txt font 3

txt lineskip -25
txt 15 0 " "
txt fill on
%txt 25  a 6 "func exec 6"
%txt 25  a 5 "func exec 5"
%txt 25  a 4 "func exec 4"
txt 25  a 3 "func exec 3"
txt 25  a 2 "func exec 2"
txt 25  a 1 "func exec 1"
txt fill off
txt left
txt 15 a "Configurations:"
