button clk birman <bfacf/birman.kps -1 -1 0 0 0 2

button clk test1 <bfacf/test1.kps -2 -1 0 0 0 2
button clk test2 <bfacf/test2.kps -1 -1 0 0 0 2
button clk test3 <bfacf/test3.kps -1 -1 0 0 0 2

button 18 "Ergodicity classes" nop 4 -2 102 10 4 2
<bfacf/ergod/buttons.kps

