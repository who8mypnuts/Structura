require KPbuild 4691
<bfacf/basicinit.kps
ccmode=2
silent=t
bfacf cent off

load bfacf/ob4.k


bfacf load

% the following nonsense is because of a bug in the recentering routines

bfacf fill -120 -120 -120  120  120 -120
bfacf fill -120 -120  120 120  120 120

bfacf fill -120 -120 -120 -120  120  120 
bfacf fill 120 -120 -120 120  120  120 

bfacf fill -120 -120 -120   120 -120  120 
bfacf fill -120 120 -120   120 120  120 

scale = 0.33
cyl-rad = 0.12
bead-radius = 0.2
mode cB
untran

txt centre

txt font 4
alias ~ttitle "txt c -20 {trefoil threaded through rings}"

alias ~rtitle "txt c -20 {rings travelling along trefoil}"


alias ~freezerings "colour all sienna;colour 0 SGIteal;bfacf freeze 1;bfacf freeze 2;bfacf freeze 3"
alias ~freezetref  "colour 1 chartreuse;colour 2 violetred;colour 3 skyblue;colour 0 sienna;bfacf freeze 0"
if \rr2 < 1 then "~freezerings;~ttitle" else "~freezetref;~rtitle"

func 1 <bfacf/obstacle4.kps


silent=f

#5 echo

txt font 3

txt fcolour royalblue .6
txt push
txt expire 11
txt c 45 "click on the `run' button on the KnotPlot Control Panel"
txt pop

txt fill on
txt c 20 "reload obstacle4" <bfacf/obstacle4.kps

txt on
