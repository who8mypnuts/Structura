
if \ppar0 != 4835140 then <bfacf/cube-init.kps

#4 echo
txt init
txt centre
txt font 4
txt c -20 "In a cube"
txt on
txt fcolour hsv:108/.6/.6 .6


alloc 35000

load mscl/3.1
bfacf load
spec bfacf
mode 0

bfacf clear -30 -30 -30 30 30 30
cyl-rad=1.5
delete all
line numb 21
line dir 1 0 0
new=f
line 0 0 0
line 0 10 0
line 0 -10 0
centre
save \y
trans 0 0 10
save \x
trans 0 0 -20
load comb \x
glop back f
save \x
about y 90
load comb \x
save \x
about z 90
load comb \x
save \x
about y 90
load comb \x
load comb \y
about z 90
load comb \y
about y 90
load comb \y
mode s
info

fitto 20

cyl=2

bfacf fill tube
bfacf dilate
bfacf clear tube


bfacf latshow 30


bfacf fill

cyl-rad=.1
mode cB
bfacf copy


