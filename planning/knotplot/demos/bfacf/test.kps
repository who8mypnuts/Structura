
delete all

txt clobber on
txt font 2
txt fill off
txt cent
txt c -44 "3 xing knot"
txt font 4
txt left


load mscl/0.1
bfacf load

bfacf centre off
spec bfacf

% don't show all the lattice
bfacf latshow 30

bfacf box 9
bfacf fill -9 -9 1 9 9 1
bfacf fill -9 -9 -1 9 9 -1
bfacf lats 9 9 1

% don't forget to refill the location where the knot is!
bfacf fill


