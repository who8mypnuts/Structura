require KPbuild 4136

if \ppar0 != 3573777 then <bfacf/phage-init.kps


#4 echo
txt init
txt centre
silent=t
txt fcolour hsv:108/.6/.6 .6
silent=f
txt font 4
txt c -20 "Phage"
txt clobber on
txt on

spec -bfacf

alloc 32016

func init
func silent
func 1 <bfacf/phage-config1.kps
func 2 <bfacf/phage-config2.kps
func 3 <bfacf/phage-config3.kps
func 4 <bfacf/phage-config4.kps
func 5 <bfacf/phage-config5.kps

func exec \ri[1/5]

txt font 3

txt lineskip -25
txt 15 0 " "
txt fill on
txt 25  a 5 "func exec 5"
txt 25  a 4 "func exec 4"
txt 25  a 3 "func exec 3"
txt 25  a 2 "func exec 2"
txt 25  a 1 "func exec 1"
txt fill off
txt left
txt 15 a "Configurations:"

glop backface t

