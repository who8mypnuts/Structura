alloc 16008

if \ppar0 != 5988631 then <bfacf/door-init.kps

scenery init
scenery object bfacf/test1
scenery object bfacf/test2
scenery on


txt init
txt lineskip 20
txt left
txt font 3
txt group 108
txt 10 -20 "Wait until the right hand zone fills up,"
txt 10 a    "and then click on the button on the bottom of"
txt 10 a    "the window to break on thru to the other side!"

txt 10 a1.5 "Things to try: "
txt 90 a0 "rotate the view in the meantime"
txt 90 a1 "reduce the step interval (now at 5000)"
txt 90 a1 "reduce the z-value"

txt fcolour hsv:0/1/1 .6
txt fill on
txt centre
txt font 4

alias ~scen "silent=t;scenery delete;scenery object bfacf/test2;scenery object bfacf/test1a;silent=f"

txt c 30 "break on thru!" "~scen;bfacf clear 0 1 1;txt delete group 108"
txt on




back=#000
ccmode = 1

knot numb \ri[1/10] mscl
trans 7 0 0

bfacf load

#3 echo

bfacf box 12
bfacf latshow 13
bfacf fill 0 11 11
%spec bfacf
bfacf copy

mode cB
bfacf z 1

spec -bfacf

bfacf run 5000


func 9 accbuff clear



scenery init
scenery object bfacf/test1
scenery object bfacf/test2
scenery on

