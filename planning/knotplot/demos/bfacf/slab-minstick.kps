txt delete group 33

txt group 55
txt font 3
txt cent
txt lineskip -22

txt fill on
txt c 10 "retrieve min" <bfacf/slab-retrieve.kps


txt fill off
txt c a "try adjusting the z value up and down"
txt c a "click on 1000000 button to improve speed"
txt c a1.5  "searching for minimal stick..."

txt group 0

bfacf target 108
bfacf search on

par0=0

spec bfacf
energy model nbeads
spec +energy

bfacf run 1000


