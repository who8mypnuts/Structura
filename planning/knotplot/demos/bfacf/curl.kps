if \ppar0 != 1644450 then <bfacf/curl-init.kps

txt init
txt centre
txt font 4
txt c -20 "Curled cavity"
txt on
%txt fcolour hsv:108/.6/.6 .6


alloc 16008
load mscl/3.1
translate 10 0 0
clk load
show bfacf
mode 0

clk clear -30 -30 -30 30 30 30
cyl-rad=1.5
delete all
line dir 0 1 0
line numb 200
line
centre

translate 10 0 0

swirl 10
scale 1 .4 1

mode s


bfacf fill tube
bfacf dilate
bfacf clear tube


bfacf latshow -14 -44 -14 14 44 14


bfacf fill

mode cB
cradius=.1
bfacf step 1

txt on
