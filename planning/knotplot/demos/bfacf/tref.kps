if \ppar0 != 1579556 then <bfacf/tref-init.kps


#4 echo
txt init
txt centre
txt font 4
txt c -20 "Trefoil tube cavity"
txt on


alloc 32016

func 1 <bfacf/tref-config1.kps
func 2 <bfacf/tref-config2.kps
func 3 <bfacf/tref-config3.kps
func 4 <bfacf/tref-config4.kps
func 5 <bfacf/tref-config5.kps

func exec \ri[1/4]

txt fcolour hsv:108/.6/.6 .6
txt font 3

txt lineskip -25
txt 15 0 " "
txt fill on
txt 25  a 5 "func exec 5"
txt 25  a 4 "func exec 4"
txt 25  a 3 "func exec 3"
txt 25  a 2 "func exec 2"
txt 25  a 1 "func exec 1"
txt fill off
txt left
txt 15 a "Configurations:"
