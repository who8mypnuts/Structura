
require KPbuild 4224

alloc 16008


reset all
bfacf init
bfacf init knotmode
mode cB
scale=.238

back=#000
load mscl/0.1
trans 10 0 0
bfacf load

load mscl/0.1
trans -10 0 0
bfacf combine

ccmode = 2
colour 0 red
colour 1 green

bfacf box 12
bfacf latshow 13
bfacf fill 0 11 11
%spec bfacf
bfacf copy

mode cB

try = 0.430000
viewmatrix 1.000000 0.000000 0.000000 0.000000 0.891007 -0.453990
if \rr2 < 1 then "rotate y -10" else "rotate y 10"


txt lineskip 20
txt left
txt font 3

txt on


bfacf run 5000
%bfacf clear 0 1 1
bfacf clear 0  2 2


%spec bfacf
func 9 accbuff clear

bfacf z .228816

bfacf run 5000

scenery object bfacf/test1a
scenery object bfacf/test2
scenery on
