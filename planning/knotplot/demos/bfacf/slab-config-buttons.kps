txt push
txt fill off
txt font 3
txt group 33
txt lineskip -25
txt 15 0 " "
txt fill on
txt 30  a "user 1"   "kloaduser 1"
txt 30  a "user 0"   "kloaduser 0"
txt 30  a "10 xing" "kload 10 \ri[1/165]"
txt 30  a "9 xing" "kload 9 \ri[1/49]"
txt 30  a "8 xing" "kload 8 \ri[1/21]"
txt 30  a "7 xing" "kload 7 \ri[1/7]"
txt 30  a "6 xing" "kload 6 \ri[1/3]"
txt 30  a "5 xing" "kload 5 \ri[1/2]"
txt 30  a "4 xing" "kload 4 1"
txt 30  a "3 xing" "kload 3 1"
txt 30  a "0 xing" "kload 0 1"

txt fill off
txt left
txt 5 a "Configurations:"

txt fill on

%txt 15 a4 "auto move 2" "read bfacf/slab2-auto.kps;bfacf run 1000000"
%txt 15 a "auto move 1" <bfacf/slab2-auto.kps

txt 15 a2 "move wall 2" "bfacf wall 2"
txt 15 a "move wall 1" "bfacf wall 1"

txt pop
