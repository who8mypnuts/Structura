
load  mscl/2.2.1

save \x
keep 0
bfacf load
load \x
keep 1
bfacf combine

delete all
new = f
frame comm "unknot 6 %d"
frame 1 to 30
about x 90

bfacf latshow 33


cyl-rad=2

bfacf fill tube
bfacf dilate
bfacf clear tube

cyl-rad=.1
bfacf copy
spec bfacf

% don't forget to refill the location where the knot is!
bfacf fill
bfacf copy
hincr=180

txt clobber on
txt font 2
txt fill off
txt cent
txt c -44 "configuration 3"
