button 18 "KnotPlot catalog" nop 4 -2 102 10 4 3
button bfacf "1 comp" "ccmode=2;knot numb \ri[1/250] mscl;bfacf load;panel set bfacf 0" -2 -1 -2 0 0 3
button bfacf "2 comp" "ccmode=2;knot numb \ri[251/342] mscl;bfacf load;panel set bfacf 0" -1 -1 -2 0 0 3
button bfacf "3 comp" "ccmode=2;knot numb \ri[343/378] mscl;bfacf load;panel set bfacf 0" -1 -1 -2 0 0 3
button bfacf "4 comp" "ccmode=2;knot numb \ri[379/383] mscl;bfacf load;panel set bfacf 0" -1 -1 -2 0 0 3
button 18 " " nop 4 -2 102 10 4 3
button pos 3
button 18 cancel "panel set bfacf 0" -1 -1 -2 0 0 3
button 18 "*** NEW: click on the `help' button for important information" nop 4 -2 102 10 4 3
