if par9 != 8263493 then "reset all;back=#000" else <wave-init.kps

silent=t
cyl=.06
trx = -2.528603
try = -0.020898
trz = 0.000000
scale = 0.311814

wavefront nwaves 222
wavefront c \rr[2.5/4]
N-torus = \ri[35/90]

wavefront skip \pN-torus

scale = \rr[.3/.38]

verbose = f

tfunc 2 "coll a;force 1"

torus 2 3
%<randorient.kps

go inf limit 30

func init
func silent


alias ~sel1 "txt set selected"
<wave_demo_aux.kps
alias ~sel1 nop
txt exec w 109

silent=f
