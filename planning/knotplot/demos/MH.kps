reset all
func init
func silent
silent=t
func 1 <MH.kps
func 4 "tanf=t;tanmag=.005"
%func 5 "3dop bead 30 30"
bead=.6
back=0
spring = 1.2
mode B
mathsv b 0 0 0 e
mathsv b 0 0 1 d
3dop bead 15 15
<random-lights
%dstep=6
elec=t
charge=.13
mech=f
coll a
force 1
velf=t
%velmag=\rr[.2/.8]
velmag=.5
amech=t
scale = \rr[.2/.35]
func 2 <MH-prep.kps
frame comm "func exec 2"
frame 2 num \ri[1/5]

align ax
<randorient.kps

ago 44
go

open all
velf=f

%tfunc \rr[2/11] "open all;velf=f"
%tfunc \rr[11/22] "velf=t;velmag=.01"
%tfunc \rr[22/66] "close all"
silent=f

func 2 "dele all;read MH-prep.kps;velf=f;open all;align ax;read randorient.kps;go"

echo 
echo 
%echo "  *** Press F5 for super-luxo beads."
echo
