% Friday, 3 Feb 1995
%
% This script is useful to setup things so they look
% nice when relaxing.
%
% Try 
%
%     conway 3
%     ago 400
%
% or 
%     tangle 111111c
%     ago 400
%
% after running the script.
%
% Very interesting in stereo-mode with the lights off.


reset all
silent = t
blend one one
back = 0
cyl = .01
bead-rad = .015
coll a
force 1

scale = 1.48
mode cb
hooke 30
mathsv k 222 .9 .1 d
mathsv k 22 .96 0 s
mathsv k  0 0 0 a

mathsv b 0 0 0 e
mathsv b 0 0 0 s
mathsv b 22 .94 .9 d
mathsv b 0 0 0 a
time .13
conway 3

singlebuff
disp
disp
clrfun 1


silent = f

