
reset all

silent=t
func init
func silent
func 1 <glueing-graphs.kps
func 2 "echo;echo Randomizing bead locations;jitter 99999;fitto 10"
func 3 "echo;glue init;frame 0 num \ri[1/4]"
func 4 "func exec 3;func exec 2"
func 5 close all
func 6 open all
func 12 reset all

verbose=f
back=0
if \rr2 < 1 then "sat = \rr1"
cyl=\rr[.04/.25]
cluster=\rr[.3/.6]
mode sC
scale=\rr[.25/.5]

hstart=\rr360
fixcofm=t

new=f
frame comm "line num \ri[4/22];line"
frame 0 num \ri[10/22]
func exec 4
hincr = 0
mathsv C \phsta \psatu 1 d

%#12 glue -1 -1
%tfunc 1 "glue -1 -1" 0 rep 10 20
tfunc 1 "glue -1 -1" 0 rep .4 \rr[.5/2]

tfunc \rr12 "open all" 0 rep  \rr[10/20] \rr[20/40]
tfunc \rr12 "close all" 0 rep \rr[10/15] \rr[16/30]

tfunc \rr1 "func exec \ri[5/6]"

frame comm "glue -1 -1"
coll a
force 1
velf=t
dstep=\ri[1/3]
%dstep = 1
go
silent=f


echo
echo

