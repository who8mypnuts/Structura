reset all

silent=t
alloc 5000
if \rr2 < 1 then "back=0"
if \rr3 < 1 then "torus function 1"
func silent
func init

func 1 <swirlA.kps
func 12 "silent=t;tfunc reset;idle;silent=f"

tfunc allowreset
tfunc \rr[10/20] <swirlA.kps

Draw=f
cyl=.1
torus \ri[1/11] \ri[1/22] 777 \rr[3/8] \rr[1/3]
about z 90   % make y axis the line of symmetry
if \rr4 < 1 then "knot cd;refine 5"
fitto 10
<randorient.kps

if \rr2 < 1 then "ortho"
if \rr4 < 3 then "mode E;back=0;hsta=\rr360"

Draw=t
nop \t0
par0=\rr[1/7]
k = \ri[0/2]  % doesn't work with `i', why?
idle "swirl \pk \T1"

silent=f

echo 
echo
echo "  *** Press F1 to rerun the demo."
echo "      Press F12 to stop the swirling."
echo

