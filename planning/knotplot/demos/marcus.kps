require KPbuild 4965

reset all

func init
func silent
func 1 <marcus.kps

xsilent=t
coll a
force 1
velf=t
mode 0
back=0
scale=.2
verbose=f

knot 1

<randorient.kps
refl r
tanmag=-.1

if \rr4 < 1 then "tanf=on"

txt init
txt font \ri[3/4]

<txt_colours.kps

par0 = \rr3

