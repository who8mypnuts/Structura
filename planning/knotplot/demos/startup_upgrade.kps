require KPfreenr

reset all

silent=t
ncurve = 7
nsegments = 15
vcn = 4
vcphi = 0.000000
vcA = 0.568359
scale = 0.864361
cyl-rad=.2
load KnL_p139d.k

go 216
stus=1

wlay evaluation

txt centre
txt font 4
txt c -30 "Welcome to KnotPlot!"
txt c a " "

txt c a "You are running KnotPlot Level 0 (the evaluation version)."
txt c a "In this version, some features of the"
txt c a "the program are disabled."

txt c a "If you want to have all that the program features"
txt c a "please consider upgrading your copy of KnotPlot"
txt c a "to Level 1 by clicking on the `upgrade now' button below."

txt c a " "
txt c a " "

txt fill on
txt colour #000
txt fcolour hsv:33/0/1

txt font 4
txt c a  "upgrade now" <web-upgrade.kps

txt fill off

txt c a " "

txt fill on
txt fcolour hsv:33/0/.8
txt font 3

txt c a "upgrade later" "reset all"

txt fill off

txt colour #fff
txt lineskip 14
txt c a " " 
txt c a " " 

txt c a "Be sure to click on the `help' button to read about"
txt c a "basic KnotPlot user interaction tasks (on the top of"
txt c a "the KnotPlot Control Panel)."

txt c a3 "When you purchase KnotPlot, you will receive an email from"
txt c a  "customerservice@hypnagogic.net with a key and instructions"
txt c a  "on how to install it.  Make sure that any spam filters you may"
txt c a  "have are set to allow email from customerservice@hypnagogic.net"

txt c a2 "After you receive your key from customerservice@hypnagogic.net"
txt c a  "install it by clicking on the button below"
txt font 4
txt fill on
txt colour #000
txt c a2 "install key"  "admin installkey"

par0 = 1522062301


txt on
silent=f
