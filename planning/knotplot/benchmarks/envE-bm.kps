reset all

silent=t
back=0
tex reset
%viewmatrix -0.233368 0.088746 -0.968330 0.126931 0.990086 0.060149
scale = 0.2
cyl-rad=.9
if \rr2 < 1 then "rot x 90" else "rot x -90"
%try=1.13

line dir .023  .005 0
line num 1022
line
fitto 10
trans to 0 0 0
%exit
#25 swirl 20;disp t
#22 scale 1 .65 1

anim cyl-rad .9 1.808024 1.0 log
anim satu 1 0 1.0 

tex appmode modulate
tex mode normal
draw tex

spec fra
if \rr1 < .5 then "texture varo.ppm" else "texture lupin.ppm"

idle "rotate y 1"
%clrfun zt
silent=f
texture on

<../benchmarks/blurb-bm.kps


